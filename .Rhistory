}
# --- Define inpatient ward types
inpatient_codes <- c("in", "icu", "eme", "mix")
# --- Filter inpatient data ---
inpatient_df <- filter(data_summary_df, ward_type %in% inpatient_codes)
tl_inpatient <- nrow(inpatient_df)
# --- Count complete admission dates ---
tl_admis_date <- sum(!is.na(inpatient_df$date_admis))
# Calculate completeness percentage ---
pct_admis_date <- ifelse(tl_admis_date > 0, (tl_admis_date / tl_inpatient) * 100, 0)
pct_admis_date <- sprintf("%.2f", pct_admis_date)
# --- Update admis_date number and percentage ---
demogs_df <- demogs_df %>% mutate(pct = ifelse(required_data == "date_admis", pct_admis_date, pct))
demogs_df <- demogs_df %>% mutate(total_number = ifelse(required_data == "date_admis", tl_admis_date, total_number))
# --- Compute completeness of demogs data percentage ---
pct_complete <- mean(as.numeric(demogs_df$pct))
pct_complete <- format(round(pct_complete, 2), nsmall = 2)
# -- Calculate % with 2 decimal points --
format_pct <- function(x) sprintf("%0.2f", x)
# -- Compute invalid values against reference list --
compute_invalids <- function(invalid_df, colname, label) {
# Use the string directly in the if statement
if (colname == "date_admis") {
row_sum <- nrow(inpatient_df)
} else {
row_sum <- nrow(data_summary_df)
}
inv_organism <- invalid_df %>%
group_by(.data[[colname]]) %>%
summarise(Number = n(), .groups = "drop") %>%
mutate(
required_data = label,
pct = format_pct(sum(Number) / row_sum * 100)
)
if (nrow(inv_organism) == 0){
inv_organism <- data.frame(spec_type = "None", Number = "",  required_data = label, pct = format_pct(0))
}
label <- gsub(" ", "_", label)
write_csv(invalid_df, paste0("Output_files/", label, ".csv"))
return(data.frame(inv_organism))
}
# -- Invalid Organism Codes --
org_vec <- read.xlsx("Reference_files/ORG GROUPINGS_09042024.xlsx", sheet = "extended_list_complete") %>%
pull(WHONET_ORG_CODE) %>% na.omit()
inv_organism_df <- data_summary_df[!data_summary_df$organism %in% org_vec, ]
inv_organism_df$organism <- ifelse(is.na(inv_organism_df$organism), "(blank)", inv_organism_df$organism)
inv_organism_summary <- compute_invalids(inv_organism_df,"organism" , "List of Invalid Codes")
# -- Invalid Specimen Date --
f_date <- paste0(f_year, "-", f_month)
inv_specdate_df <-  data_summary_df[!grepl(paste0("^", f_date), data_summary_df$spec_date), ]
inv_specdate_df$spec_date <- ifelse(is.na(inv_specdate_df$spec_date), "(blank)", inv_specdate_df$spec_date)
inv_specdate_summary <- compute_invalids(inv_specdate_df, "spec_date","List of Invalid Specimen Date")
# -- Invalid Admission Dates --
# Convert strings to Date objects
start_date <- as.Date(paste0(f_year, "-01", "-01"))
end_date <- as.Date(paste0(f_date, "-01"))
# Generate sequence of dates by month
month_seq <- seq(start_date, end_date, by = "month")
# Format back to "YYYY-MM"
accepted_months <- format(month_seq, "%Y-%m")
pattern <- paste0("^", accepted_months, collapse = "|")
inv_admis_df <- inpatient_df[!grepl(pattern, inpatient_df$date_admis), ]
inv_admis_df$date_admis <- ifelse(is.na(inv_admis_df$date_admis), "(blank)", inv_admis_df$date_admis)
inv_admis_summary <- compute_invalids(inv_admis_df, "date_admis","List of Invalid Date of Admission for Verification")
# -- Invalid Specimen Types --
spec_vec <- read.xlsx("Reference_files/SPCLIST_referrables_09042026_1.xlsx", sheet = "complete_specimenlist") %>%
pull(SPEC_TYPE) %>% na.omit()
inv_spectype_df <- data_summary_df[!data_summary_df$spec_type %in% spec_vec, ]
inv_spectype_df$spec_type <- ifelse(is.na(inv_spectype_df$spec_type), "(blank)", inv_spectype_df$spec_type)
inv_spectype_summary <- compute_invalids(inv_spectype_df,"spec_type" , "List of Invalid Specimen Type")
# -- Invalid Ward Type --
inv_ward_df <- data_summary_df[is.na(data_summary_df$ward_type), ]
inv_ward_df$ward_type <- ifelse(is.na(inv_ward_df$ward_type ), "(blank)", inv_ward_df$ward_type)
inv_ward_summary <- compute_invalids(inv_ward_df,"ward_type" , "List of Invalid Ward Type")
# -- Read and clean invalid mic data --
invalid_mic_summary <- read.csv("Output_files/invalid_mic_summary.csv") %>%
select(-X) %>%
relocate(abx_name, .before = column) %>%
arrange(desc(count))
if (nrow(invalid_mic_summary) != 0){
mic_col_inv <- invalid_mic_summary$column
abx_df_list <- list()  # initialize list
for (mic in mic_col_inv) {
# Get invalid counts
inv_count <- invalid_mic_summary$count[invalid_mic_summary$column == mic]
mic <- tolower(mic)
abx_df <- df %>%
summarise(number_tested = sum(!is.na(.data[[mic]])))
abx_df <- abx_df %>%
mutate(column = toupper(mic),
pct = format_pct(inv_count / number_tested * 100))
abx_df_list[[mic]] <- abx_df  # store by column name
}
# -- Combine all into one dataframe
final_abx_df <- bind_rows(abx_df_list)
# -- Convert pct to numeric (remove formatting if needed)
final_abx_df <- final_abx_df %>%
mutate(pct_numeric = as.numeric(pct))
# -- Calculate average (ignoring NA if any)
mic_inv_pct <- mean(final_abx_df$pct_numeric, na.rm = TRUE)
mic_inv_pct <- format_pct(mic_inv_pct)
} else{
mic_inv_pct <- format_pct(0)
}
org_path <- "Reference_files/ORG GROUPINGS_09042024.xlsx"
at_path  <- "Reference_files/CLSI_ORG_ATC_09162025_cel_edit_mayette.xlsx"
get_at_count <- function(data, at_type, df_antibiotic, section_name) {
df_abx <- df_antibiotic[df_antibiotic$ADD_VAL == at_type, ]
# Get relevant column codes and intersect with data
get_cols <- function(code_col) {
intersect(trimws(as.character(na.omit(df_abx[[code_col]]))), colnames(data))
}
disk_cols  <- get_cols("WHON5_CODE_DISK")
mic_cols   <- get_cols("WHON5_CODE_MIC")
etest_cols <- get_cols("WHON5_CODE_ETEST")
# Count tested (1 if any method has a value, else 0)
at_count <- as.data.frame(ifelse(
!is.na(data[disk_cols]) | !is.na(data[mic_cols]), 1,
ifelse(!is.na(data[etest_cols]), 1, 0)
))
if (nrow(at_count) == 0) at_count[1, ] <- 0
# Rename columns to antibiotic panel names
colnames(at_count) <- df_abx$Antibiotic_Panels[match(colnames(at_count), df_abx$WHON5_CODE_DISK)]
# Summarize
df_summary <- data.frame(
antibiotic_name = colnames(at_count),
total_tested    = colSums(at_count),
pct             = ifelse(colSums(at_count) != 0,
format_pct(colSums(at_count) / nrow(at_count) * 100), 0),
row.names       = NULL
)
# Handle "add" type (Colistin/Polymyxin B special case)
if (!is.na(at_type) && at_type == "add") {
# Filter first
df_summary <- df_summary[df_summary$total_tested != 0, ]
# Safely handle assignment or fallback
if (is.null(df_summary) || nrow(df_summary) == 0) {
df_summary <- data.frame(
antibiotic_name = "Colistin or Polymyxin B",
total_tested = 0,
pct = 0,
stringsAsFactors = FALSE
)
} else {
# This handles 1 or more rows safely without throwing a row-mismatch error
df_summary$antibiotic_name <- rep("Colistin or Polymyxin B", nrow(df_summary))
}
}
# Add section header row
lbl_tested <- ifelse(at_type == "NA", "Number", "")
header     <- data.frame(antibiotic_name = section_name,
total_tested    = lbl_tested,
pct             = nrow(data))
rbind(header, df_summary)
}
at_monitoring_summary <- data.frame(antibiotic_name = character(),
total_tested    = integer(),
pct             = integer())
abx_monitoring <- function(org_code, abx_group) {
org_code_vec <- read_xlsx(org_path, sheet = org_code) |> pull(ORG) |> na.omit()
at_df <- filter(data_summary_df, organism %in% org_code_vec)
if (nrow(at_df) == 0) return(NULL)
at_total     <- nrow(at_df)
at_df_ur     <- filter(at_df, spec_type == "ur")
df_antibiotic <- read_xlsx(at_path, sheet = org_code)
additional_at <- unique(df_antibiotic$ADD_VAL)
# Build monitoring table by looping through specimen types
abx_monitoring_df <- do.call(rbind, lapply(additional_at, function(at) {
data_source  <- if (!is.na(at) && at == "ur") at_df_ur else at_df
section_name <- ifelse(at == "NA", abx_group,
ifelse(at == "ur", "Additional for Urine", "Additional Antibiotic/s"))
get_at_count(data_source, at, df_antibiotic, section_name)
}))
# 1. Identify optional and "or" names
all_or_statuses <- unique(df_antibiotic$STATUS[grep("^or", df_antibiotic$STATUS)]) # captures "or", "or1", "or2", etc.
optional_names  <- na.omit(df_antibiotic$Antibiotic_Panels[df_antibiotic$STATUS %in% c(all_or_statuses, "optional")])
# 2. Initial cleaning: Remove rows with "Number" or blank total_tested
cleaned_df <- abx_monitoring_df[!(abx_monitoring_df$total_tested %in% c("Number", "")), ]
cleaned_df$pct_num <- as.numeric(cleaned_df$pct)
# 3. Handle the "or" groupings
# Merge the STATUS column from df_antibiotic into your monitoring dataframe to know which group is which
or_mapping <- df_antibiotic[df_antibiotic$STATUS %in% all_or_statuses, c("Antibiotic_Panels", "STATUS")]
names(or_mapping) <- c("antibiotic_name", "or_group")
or_df <- cleaned_df[cleaned_df$antibiotic_name %in% or_mapping$antibiotic_name & cleaned_df$total_tested > 0, ]
or_df <- merge(or_df, or_mapping, by = "antibiotic_name", all.x = TRUE)
# Group by the specific "or" status (or1, or2) and extract the row with the highest percentage for each
if (nrow(or_df) > 0) {
or_df_list <- split(or_df, or_df$or_group)
or_filtered_list <- lapply(or_df_list, function(sub_df) {
sub_df[which.max(sub_df$pct_num), ]
})
or_final <- do.call(rbind, or_filtered_list)
or_final$or_group <- NULL # Clean up the temporary group column
} else {
or_final <- or_df[, names(cleaned_df)] # Empty dataframe with matching columns
}
# 4. Get the standard (non-"or") antibiotics
standard_df <- cleaned_df[
!(cleaned_df$antibiotic_name %in% or_mapping$antibiotic_name) &
!(cleaned_df$antibiotic_name %in% optional_names & cleaned_df$total_tested == 0),
]
# 5. Combine standard data with the highest representative of each "or" group
at_ov_percentage <- rbind(standard_df, or_final)
# 6. Final calculation
pct_ave <- format_pct(mean(round(at_ov_percentage$pct_num), na.rm = TRUE))
at_monitoring_summary <<- rbind(at_monitoring_summary,
data.frame(antibiotic_name = abx_group,
total_tested    = at_total,
pct             = pct_ave))
return(abx_monitoring_df)
}
ebc_at_monitoring <- abx_monitoring('ebc','ENTEROBACTERIACEAE except \\textit{Salmonella} \\& \\textit{Shigella} species')
sal_shi_at_monitoring <- abx_monitoring("sal_shi","\\textit{Salmonella} \\& \\textit{Shigella}")
if(nrow(df) != 0){
rmarkdown::render("data_summary_report.Rmd",
output_file = paste('WHONET_Data_Summary_',get_file,
'.pdf', sep=''))
}else{
cat("No file found")
}
# Core Data Wrangling & Utilities
library(tidyverse)     # Covers dplyr, purrr, tibble, stringr, readr, ggplot2, tidyr, etc.
library(conflicted)
# Database & External Services
library(DBI)
library(RPostgres)
library(googlesheets4)
# Excel Handling (Choose openxlsx OR readxl/writexl)
library(readxl)
library(writexl)
# Domain Specific & Reporting
library(AMR)
library(svDialogs)
library(knitr)
library(kableExtra)
library(tinytex)
library(remotes)
conflicts_prefer(dplyr::filter)
conflicts_prefer(dplyr::lag)
# --- Set Working Directory ---
setwd("E:/DMU Projects/data-summary-report")
# taking input with showing the message
file_year <- dlgInput("Enter year of data: ", Sys.info()[" "])$res
rcvd_file <- dlgInput("Enter date received:", Sys.info()[" "])$res
#get_file = readline(prompt = "Enter filename : ");
get_file <- dlgInput("Enter a filename", Sys.info()[" "])$res
getDataFrameFromRawDB <- function(x) {
db <- 'dmu_whonet'  #provide the name of your db
#host_db <- "10.10.103.163" #i.e. # i.e. 'ec2-54-83-201-96.compute-1.amazonaws.com'
host_db <- "10.10.103.222"
db_port <- '5432'  # or any other port specified by the DBA
#db_user <- "postgres"
db_user <- "arsp_dmu"
#db_password <- "secret123"
db_password <- "R3sistance"
con <- dbConnect(RPostgres::Postgres(), dbname = db, host=host_db, port=db_port, user=db_user, password=db_password)
query <- dbGetQuery(con, paste0("SELECT *
FROM whonet_rawfilename
INNER JOIN whonet_raworigin on whonet_rawfilename.id = whonet_raworigin.file_ref_id
INNER JOIN whonet_rawlocation on whonet_raworigin.id = whonet_rawlocation.origin_ref_id
INNER JOIN whonet_rawspecimen on whonet_raworigin.id = whonet_rawspecimen.origin_ref_id
INNER JOIN whonet_rawmicrobiology on whonet_raworigin.id = whonet_rawmicrobiology.origin_ref_id
INNER JOIN whonet_rawantidisk on whonet_raworigin.id = whonet_rawantidisk.origin_ref_id
INNER JOIN whonet_rawantimic on whonet_raworigin.id = whonet_rawantimic.origin_ref_id
INNER JOIN whonet_rawantietest on whonet_raworigin.id = whonet_rawantietest.origin_ref_id
WHERE
whonet_rawfilename.file_name LIKE '%", get_file, "%'"))
#whonet_rawfilename.file_name LIKE '", get_file ,"'"))
df <- data.frame(query)
return(df)
}
df <- getDataFrameFromRawDB()
file_name <- paste0("Output_files/",get_file,"_raw_file.xlsx")
write_xlsx(df, file_name)
drop_cols <- c("created_at","updated_at","file_ref_id","origin_ref_id")
df <- df[!grepl(paste0(drop_cols,collapse="|" ),names(df))]
df <- df %>%
add_column(date_received = rcvd_file, .before = "id") %>%
add_column(data_year = file_year, .after = "date_received")
names(df)[names(df) == 'id'] <- 'file_id'
names(df)[names(df) == 'id..5'] <- 'id'
names(df) <- toupper(names(df))
#replace NaN / NaT  values to NA to Blank
df[df == 'nan'] <- NA
df[df == 'NaN'] <- NA
df[df == 'NaT'] <- NA
df[df == ""] <- NA
#write.csv(df, "Output_files/raw_df.csv")
write.csv(df, "Output_files/raw_df.csv")
# Convert custom values to nearest accepted twofold dilution
df$GEH_NM <- sub("^(\\d+)\\.0$", "\\1", df$GEH_NM)
df$STH_NM <- sub("^(\\d+)\\.0$", "\\1", df$STH_NM)
df$GEH_NM[df$GEH_NM == "513"] <- ">512"
df$GEH_NM[df$GEH_NM == ">513"] <- ">512"
df$GEH_NM[df$GEH_NM == ">500"] <- ">512"
df$GEH_NM[df$GEH_NM == "<=500"] <- "<=512"
df$GEH_NM[df$GEH_NM == "<500"] <- "<512"
df$STH_NM[df$STH_NM == "1025"] <- ">1024"
df$STH_NM[df$STH_NM == ">1025"] <- ">1024"
df$STH_NM[df$STH_NM == ">1000"] <- ">1024"
df$STH_NM[df$STH_NM == "<=1000"] <- "<=1024"
df$STH_NM[df$STH_NM == "<1000"] <- "<1024"
# NOTES:
# The AMR package uses its own internal validation to ensure MIC values fall within acceptable ranges and discrete steps.
# These values (like 500 or 1000) are not part of the twofold dilution series and therefore will be flagged as invalid—even if a guideline like CLSI allows it in a specific case.
# You can convert such values to accepted approximations manually before processing.
# Reference on official AMR package website: https://amr-for-r.org/reference/as.mic.html
write.csv(df, "Output_files/raw_df_edited.csv")
ris_data <- df %>%
mutate(mo = as.mo(ORGANISM)) %>%
mutate(across(matches("_ND"), as.disk)) %>%
mutate(across(matches("_N[ME]"), as.mic))
sir_cols <- names(ris_data)[grepl("_N[DEM]", names(ris_data))]
for (col in sir_cols) {
ab_code <- sub("_.*", "", col)
ris_data[[col]] <- as.sir(
ris_data[[col]],
mo = ris_data$mo,
ab = ab_code,
guideline = "CLSI 2026",
breakpoint_type = "human"
)
}
write.csv(ris_data, file="Output_files/data_ris.csv")
# Get antibiotic name df
abx_df <- read_xlsx("Reference_files/antibiotics_for_db.xlsx")
# Check for invalid MIC values
# Step 1: Dynamically get MIC column names
mic_cols <- grep("_N[ME]", names(df), value = TRUE)
# Step 2: Clean, convert, and create new <mic> columns
df_mic <- df %>%
mutate(across(all_of(mic_cols), ~ trimws(as.character(.)))) %>%
mutate(across(all_of(mic_cols),
~ suppressWarnings(as.mic(., keep_operators = "all")),
.names = "{.col}_mic"))
invalid_mic_summary <- map_dfr(mic_cols, function(col) {
raw_vals <- df_mic[[col]]
mic_vals <- df_mic[[paste0(col, "_mic")]]
# Get invalid (non-NA raw but NA after conversion)
invalids <- raw_vals[is.na(mic_vals) & !is.na(raw_vals)]
tibble(
column = col,
invalid_values = paste(unique(invalids), collapse = ", "),
count = length(invalids),
#ab = sub("_.*", "", col),                          # e.g. "STH_NM" -> "STH"
abx_name = ab_name(sub("_.*", "", col), language = NULL)
)
}) %>%
filter(count > 0) %>%
arrange(desc(count))
write.csv(invalid_mic_summary, file="Output_files/invalid_mic_summary.csv")
if(nrow(df) != 0){
rmarkdown::render("data_summary_report.Rmd",
output_file = paste('WHONET_Data_Summary_',get_file,
'.pdf', sep=''))
}else{
cat("No file found")
}
# Load package
library(tidyverse)
library(knitr)
library(readxl)
library(kableExtra)
library(RColorBrewer)
library(scales)
library(readr)
library(DBI)
library(svDialogs)
library(writexl)
library(conflicted)
library(data.table)
library(googlesheets4)
conflicts_prefer(openxlsx::write.xlsx)
conflicts_prefer(dplyr::filter)
# --- Set Working Directory ----
setwd("E:/DMU Projects/wgs-qc-report")
# --- Read Google Sheet for Referred Database ---
#referred_sheet_id <- "1JKtyRyLh0-ck2xCk0oIH4iidgs21996UKj69lvvlXAU"
#referred_df <- read_sheet(referred_sheet_id, sheet = 1)
# referred_db credentials
con <- dbConnect(
RPostgres::Postgres(),
dbname   = "referred_db",
host     = "10.10.103.222",          # Ubuntu server IP
port     = 5432,                     # Standard Postgres port
user     = "referred_user",
password = "arsp_referred"
)
print("--- Connection Established Successfully! ---")
#  Download both tables into R memory
referred_df  <- dbReadTable(con, "Referred_Data") %>%
rename_with(tolower) %>%
rename(accession_no = accessionno) %>%
mutate(arsrl_org = ars_orgname)
# --- Google Sheet ID extracted from the URL ---
sheet_id <- "1OUnMF78Nftwu442t7N3Ly6JoEW8Wmk5z9cNY7b_KOzY"
# --- Read Google Sheets (RAW READS)---
df_batch <- read_sheet(sheet_id, sheet = "batch")
df_bactscout <- read_sheet(sheet_id, sheet = "bactscout")
# --- Read Google Sheets (ASSEMBLY)---
df_gambit <- read_sheet(sheet_id, sheet = "gambit")
df_checkm2 <- read_sheet(sheet_id, sheet = "checkm2")
df_assembly <- read_sheet(sheet_id, sheet = "assembly-scan")
#df_mlst <- read_sheet(sheet_id, sheet = "mlst")
#df_mlst <- read_sheet(sheet_id, sheet = "mlst_new")
df_amrfinderplus <- read_sheet(sheet_id, sheet = "amrfinderplus")
# --- Get Sample Sheet File ---
get_samplesheet <- dlgInput("Enter sample sheet file name:", Sys.info()[" "])$res
batch_code <- gsub("\\[edited\\]","" ,get_samplesheet)
# --- Filter Batch Dataframe based on Batch Code ---
batch_df <- df_batch[df_batch$batch_code == batch_code, ]
sample_name <- batch_df$sample_name
sample_name <- gsub("-", "_", sample_name, fixed=TRUE)
# --- Remove batch number from sample_name ---
sample_name_clean <- sub("(.*)_[^_]*$", "\\1", sample_name)
# --- Modify columns ---
colnames(df_bactscout)[which(names(df_bactscout) == "sample_id")] <- "name"
colnames(df_gambit)[which(names(df_gambit) == "sample")] <- "name"
colnames(df_assembly)[which(names(df_assembly) == "sample")] <- "name"
# --- checkm2 column names to lower ---
names(df_checkm2) <- tolower(names(df_checkm2))
# --- remove ".fna" ---
df_checkm2$name <- gsub(".fna", "", df_checkm2$name, fixed=TRUE)
# --- Get species name ---
df_gambit$species <- case_when(
df_gambit$predicted.rank == "species" ~ df_gambit$predicted.name,
TRUE ~ df_gambit$next.name
)
# --- Compute total GC Content ---
df_assembly$gc_content <- as.numeric(df_assembly$contig_percent_g) + as.numeric(df_assembly$contig_percent_c)
# --- Subset Columns per dataframe ---
gambit_sub_df <- subset(df_gambit, select = c(name, species))
checkm2_sub_df <- subset(df_checkm2, select = c(name, completeness, contamination, total_coding_sequences, genome_size))
assembly_sub_df <- subset(df_assembly, select = c(name, total_contig, gc_content, n50_contig_length))
# --- Put all data frames into list ---
df_list <- list(gambit_sub_df, checkm2_sub_df, assembly_sub_df)
# --- Merge all data frames in list ---
wgs_result_df <- df_list %>% reduce(full_join, by='name')
# --- Format Name Column ---
wgs_result_df$name <- gsub("-", "_", wgs_result_df$name, fixed=TRUE)
wgs_result_df$name <- toupper(wgs_result_df$name)
# --- Filter wgs_result_df based on sample_name ---
wgs_result_df <- wgs_result_df[wgs_result_df$name %in% sample_name, ]
# ---  Apply the function to the column of strings ---
wgs_result_df <- wgs_result_df %>% rename(sample_id = name)
# --- Subset referred_df ---
referred_df <- subset(referred_df, select = c(accession_no,arsrl_org))
# --- Create arsrl_result_df based on sample_name ---
arsrl_result_df <- referred_df[referred_df$accession_no %in% sample_name_clean, ]
colnames(arsrl_result_df) <- c('sample_id','arsrl_org')
# ---  Returns string without leading or trailing white space ---
arsrl_result_df$arsrl_org <- gsub("^\\s+|\\s+$", "", arsrl_result_df$arsrl_org)
# Arrange rows based on the target_vector
arsrl_result_df <- arsrl_result_df[match(sample_name_clean, arsrl_result_df$sample_id), ]
# --- Patterns and corresponding organisms to manually add ---
manual_samples <- tibble::tribble(
~pattern,    ~arsrl_org,
"UTP",       "Escherichia coli",
"STC",       "Burkholderia cepacia",
"QC_BBR",    "Bordetella bronchiseptica",
"VC",        "Neisseria gonorrhoeae"
)
# --- Loop through patterns and add rows if present ---
for(i in seq_len(nrow(manual_samples))) {
matches <- grep(
manual_samples$pattern[i],
wgs_result_df$sample_id,
value = TRUE
)
if(length(matches) > 0) {
arsrl_result_df <- arsrl_result_df %>%
add_row(
sample_id = sub("(.*)_[^_]*$", "\\1", matches),
arsrl_org = manual_samples$arsrl_org[i]
)
}
}
# --- Referred isolates with WGS result, but the referred data have not been endorsed for encoding to DMU ---
arsrl_id <- arsrl_result_df$sample_id
no_referred_data_id <- setdiff(sample_name_clean, arsrl_id)
# --- manually add no referred data ---
if(length(no_referred_data_id) !=0){
sample_id = no_referred_data_id
arsrl_org = "No Referred Data"
arsrl_result_df <- arsrl_result_df %>%
add_row(sample_id = sample_id, arsrl_org=arsrl_org)
}
arsrl_result_df <- arsrl_result_df %>%
filter(!is.na(sample_id))
wgs_df1 <- wgs_result_df
#wgs_df <- wgs_df1
arsrl_result_df1 <- arsrl_result_df
#arsrl_result_df <- arsrl_result_df1
if(nrow(wgs_result_df) != 0){
rmarkdown::render("wgs_qc_report_pdf.Rmd",
output_file = paste("reports/ARSRL_WGS_QC_report_",batch_code, '.pdf', sep='')
)
}else{
cat("No file found")
}
if(nrow(wgs_result_df) != 0){
rmarkdown::render("wgs_qc_report_pdf.Rmd",
output_file = paste("reports/ARSRL_WGS_QC_report_",batch_code, '.pdf', sep='')
)
}else{
cat("No file found")
}
if(nrow(wgs_result_df) != 0){
rmarkdown::render("wgs_qc_report_html.Rmd",
output_file = paste("reports/ARSRL_WGS_QC_report_",batch_code, '.html', sep='')
)
}
